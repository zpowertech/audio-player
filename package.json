{
  "name": "@zpowertech/audio-player",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser audio playback with automatic format detection, incremental SILK decoding, pause and resume",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:rust": "node scripts/rust.mjs test --workspace --locked",
    "test:package": "node scripts/test-package.mjs",
    "test:browser": "playwright test && playwright test --config=playwright.package.config.mjs && playwright test --config=playwright.examples.config.mjs",
    "verify": "npm run build && npm run test:rust && npm test && npm run test:examples && npm run test:package && npm run test:browser",
    "serve": "vite --open /examples/",
    "test:examples": "tsc -p examples/react/tsconfig.json"
  },
  "keywords": [
    "audio",
    "player",
    "silk",
    "streaming",
    "browser",
    "wasm"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "webpack": "^5.112.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  }
}
